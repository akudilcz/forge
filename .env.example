# FORGE environment configuration
# Copy to .env and fill in the values you need:  cp .env.example .env
#
# Credentials can also be entered in the Control Station under Settings —
# the environment is only one of the two supported paths.

# -----------------------------------------------------------------------------
# LLM provider — set the key for whichever provider you use
# -----------------------------------------------------------------------------

# Poe (default provider)
POE_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Any other OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, ...)
FORGE_API_KEY=
FORGE_LLM_BASE_URL=
FORGE_LLM_MODEL=

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Workspace directory FORGE builds into. Defaults to ./workspace.
FORGE_WORKSPACE=

# Set to 1 to enable dev mode (verbose errors, relaxed CORS).
FORGE_DEV_MODE=

# Optional HTTP Basic auth. Auth is only enforced when BOTH are set —
# recommended if you expose FORGE beyond localhost.
FORGE_AUTH_USER=
FORGE_AUTH_PASS=

# -----------------------------------------------------------------------------
# Integration tests (`make test-integration`)
# -----------------------------------------------------------------------------
# All four are MANDATORY for the integration suite — it has no code-level
# defaults on purpose, so a run is always reproducible and there is never any
# doubt about which model produced a result. Without them the suite fails fast
# with a message naming the missing variable.
#
# These tests make real, paid LLM calls and can run for hours. They are excluded
# from the default `pytest` run and from CI.

# Name of the env var above that holds the key — not the key itself.
FORGE_TEST_API_KEY_ENV=OPENROUTER_API_KEY

# Provider endpoint.
FORGE_TEST_BASE_URL=https://openrouter.ai/api/v1

# Model driving the agents in phases 1-11.
FORGE_TEST_MODEL=deepseek/deepseek-v4-flash-0731

# Model driving phase 12 code generation. May differ from the above — code
# generation benefits from a larger context window.
FORGE_TEST_MODEL_P12=deepseek/deepseek-v4-flash-0731
